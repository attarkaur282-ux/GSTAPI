{
  "version": 2,
  "builds": [
    {
      "src": "gst.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/gst(.*)",
      "dest": "gst.py"
    },
    {
      "src": "/health(.*)",
      "dest": "gst.py"
    },
    {
      "src": "/(.*)",
      "dest": "gst.py"
    }
  ]
}
